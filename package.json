{
  "name": "mantle-arb",
  "version": "1.0.0",
  "description": "AI-Powered DEX Arbitrage Agent on Mantle Network",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/api/server.js",
    "compile": "npx hardhat compile",
    "deploy:testnet": "npx hardhat run scripts/deploy.js --network mantleTestnet",
    "deploy:mainnet": "npx hardhat run scripts/deploy.js --network mantle",
    "test": "npx hardhat test",
    "test:unit": "node test/unit/hummingbot-modules.test.js",
    "strategy": "python3 src/strategy.py",
    "audit": "npm audit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mantle",
    "arbitrage",
    "ai",
    "defi",
    "dex"
  ],
  "author": "Tyler",
  "license": "MIT",
  "dependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^4.9.6",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "ethers": "^6.9.0",
    "express": "^4.19.2",
    "hardhat": "^2.19.0",
    "helmet": "^7.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-verify": "^2.0.0"
  }
}
